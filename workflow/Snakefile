include: "rules/cooccurrence.smk"

# Medaka polishing
include: "rules/medaka.smk"

# Plasmid Finder
include: "rules/plasmidfinder.smk"


##################################################
# FILTERING STRATEGY
##################################################
FILTERING_STRATEGY = config.get("filtering_strategy")

if FILTERING_STRATEGY == "standard":
    filtering_outputs  = expand("results/taxonomy/abundance_matrix_{level}_filtered.tsv",
                                level=TAXONOMIC_LEVELS)
    normalized_outputs = expand(
        ["results/taxonomy/abundance_matrix_{level}_relative.tsv",
         "results/taxonomy/abundance_matrix_{level}_clr.tsv"],
        level=TAXONOMIC_LEVELS)
    diversity_output   = "results/taxonomy/alpha_diversity.tsv"
    summary_output     = "results/summary/taxonomy_summary.txt"
    fig_genus_matrix   = "results/taxonomy/abundance_matrix_G_relative.tsv"
    fig_species_matrix = "results/taxonomy/abundance_matrix_S_relative.tsv"
    fig_alpha_div      = "results/taxonomy/alpha_diversity.tsv"

elif FILTERING_STRATEGY == "independent":
    filtering_outputs  = expand("results/taxonomy/abundance_matrix_{level}_filtered_independent.tsv",
                                level=TAXONOMIC_LEVELS)
    normalized_outputs = expand(
        ["results/taxonomy/abundance_matrix_{level}_relative_independent.tsv",
         "results/taxonomy/abundance_matrix_{level}_clr_independent.tsv"],
        level=TAXONOMIC_LEVELS)
    diversity_output   = "results/taxonomy/alpha_diversity_independent.tsv"
    summary_output     = "results/summary/taxonomy_summary_independent.txt"
    fig_genus_matrix   = "results/taxonomy/abundance_matrix_G_relative_independent.tsv"
    fig_species_matrix = "results/taxonomy/abundance_matrix_S_relative_independent.tsv"
    fig_alpha_div      = "results/taxonomy/alpha_diversity_independent.tsv"

else:  # "both"
    filtering_outputs  = (
        expand("results/taxonomy/abundance_matrix_{level}_filtered.tsv", level=TAXONOMIC_LEVELS) +
        expand("results/taxonomy/abundance_matrix_{level}_filtered_independent.tsv", level=TAXONOMIC_LEVELS)
    )
    normalized_outputs = (
        expand(["results/taxonomy/abundance_matrix_{level}_relative.tsv",
                "results/taxonomy/abundance_matrix_{level}_clr.tsv"],
               level=TAXONOMIC_LEVELS) +
        expand(["results/taxonomy/abundance_matrix_{level}_relative_independent.tsv",
                "results/taxonomy/abundance_matrix_{level}_clr_independent.tsv"],
               level=TAXONOMIC_LEVELS)
    )
    diversity_output   = ["results/taxonomy/alpha_diversity.tsv",
                          "results/taxonomy/alpha_diversity_independent.tsv"]
    summary_output     = ["results/summary/taxonomy_summary.txt",
                          "results/summary/taxonomy_summary_independent.txt"]
    fig_genus_matrix   = "results/taxonomy/abundance_matrix_G_relative_independent.tsv"
    fig_species_matrix = "results/taxonomy/abundance_matrix_S_relative_independent.tsv"
    fig_alpha_div      = "results/taxonomy/alpha_diversity_independent.tsv"

include: "rules/taxonomy_figures.smk"


# ═══════════════════════════════════════════════════════════════════════════════
# TARGET RULES — MetagenAMR pipeline
# ═══════════════════════════════════════════════════════════════════════════════

# ─── QC module ────────────────────────────────────────────────────────────────

rule quality_control:
    """QC, sequencing statistics, and cleaned reads."""
    input:
        expand("results/{sample}/qc/{sample}_Nanoplot/NanoPlot-report.html",
               sample=config["samples_id"]),
        expand("results/{sample}/stats/{sample}_read_stats.txt",
               sample=config["samples_id"]),
        expand("results/{sample}/clean/{sample}.renamed.fastq.gz",
               sample=config["samples_id"]),
        "results/stats/sequencing_stats.tsv",


# ─── Taxonomy modules ─────────────────────────────────────────────────────────

rule taxonomy_kraken:
    """Kraken2 + Bracken + raw abundance matrices."""
    input:
        rules.quality_control.input,
        expand("results/{sample}/kraken/{sample}_output.txt",
               sample=config["samples_id"]),
        expand("results/{sample}/bracken/{sample}_{level}.txt",
               sample=config["samples_id"], level=TAXONOMIC_LEVELS),
        expand("results/taxonomy/abundance_matrix_{level}.tsv",
               level=TAXONOMIC_LEVELS),


rule taxonomy_analysis:
    """Filtering, normalization, alpha diversity, summaries."""
    input:
        rules.taxonomy_kraken.input,
        filtering_outputs,
        normalized_outputs,
        diversity_output,
        summary_output,


rule taxonomy_viz:
    """Taxonomic visualization HTML report."""
    input:
        rules.taxonomy_analysis.input,
        "results/figures/taxonomy/taxonomy_report.html",


rule taxonomy_all:
    """Full taxonomy pipeline: QC → Kraken → analysis → HTML report."""
    input:
        rules.taxonomy_viz.input,


# ─── RGI — R matrices ──────────────────────────────────────────────────────────

rule r_analysis_rgi:
    """R matrices — RGI main (assembly-based)."""
    input:
        "results/r_analysis/rgi/arg_counts.tsv",
        "results/r_analysis/rgi/arg_relative.tsv",
        "results/r_analysis/rgi/arg_normalized.tsv",
        "results/r_analysis/rgi/arg_presence.tsv",
        "results/r_analysis/rgi/arg_matrix_counts.tsv",
        "results/r_analysis/rgi/arg_matrix_normalized.tsv",
        "results/r_analysis/rgi/arg_matrix_presence.tsv",
        "results/r_analysis/rgi/drug_class_abundance.tsv",
        "results/r_analysis/rgi/mechanism_abundance.tsv",
        "results/r_analysis/rgi/family_abundance.tsv",
        "results/r_analysis/rgi/family_prefix_abundance.tsv",


rule r_analysis_bwt:
    """R matrices — RGI BWT (read-based)."""
    input:
        "results/r_analysis/rgi_bwt/arg_counts.tsv",
        "results/r_analysis/rgi_bwt/arg_relative.tsv",
        "results/r_analysis/rgi_bwt/arg_normalized.tsv",
        "results/r_analysis/rgi_bwt/arg_presence.tsv",
        "results/r_analysis/rgi_bwt/arg_matrix_counts.tsv",
        "results/r_analysis/rgi_bwt/arg_matrix_normalized.tsv",
        "results/r_analysis/rgi_bwt/arg_matrix_presence.tsv",
        "results/r_analysis/rgi_bwt/drug_class_abundance.tsv",
        "results/r_analysis/rgi_bwt/mechanism_abundance.tsv",
        "results/r_analysis/rgi_bwt/family_abundance.tsv",
        "results/r_analysis/rgi_bwt/family_prefix_abundance.tsv",


rule r_analysis_all:
    """R matrices for both detection strategies."""
    input:
        rules.r_analysis_rgi.input,
        rules.r_analysis_bwt.input,


# ─── RGI — visualization ───────────────────────────────────────────────────────

rule viz_rgi:
    """HTML report — RGI main."""
    input:
        "results/figures/rgi/rgi_report.html",


rule viz_bwt:
    """HTML report — RGI BWT."""
    input:
        "results/figures/rgi/rgi_bwt_report.html",


rule viz_all:
    """HTML reports for both detection strategies."""
    input:
        rules.viz_rgi.input,
        rules.viz_bwt.input,


# ─── RGI — full pipelines ──────────────────────────────────────────────────────

rule rgi_main_all:
    """Full RGI assembly-based pipeline: detection → R matrices → HTML report."""
    input:
        expand("results/{sample}/rgi/{sample}.txt",
               sample=config["samples_id"]),
        expand("results/{sample}/rgi_preprocessing/{sample}_filtered.txt",
               sample=config["samples_id"]),
        expand("results/{sample}/rgi_preprocessing/{sample}_selected.txt",
               sample=config["samples_id"]),
        "results/summary/rgi_all_samples.tsv",
        "results/summary/rgi_aggr_summary.txt",
        rules.r_analysis_rgi.input,
        rules.viz_rgi.input,


rule rgi_bwt_all:
    """Full RGI BWT pipeline: detection → R matrices → HTML report."""
    input:
        expand("results/{sample}/rgi_bwt/{sample}.txt",
               sample=config["samples_id"]),
        expand("results/{sample}/rgi_bwt/{sample}.gene_mapping_data.txt",
               sample=config["samples_id"]),
        expand("results/{sample}/rgi_bwt_preprocessing/{sample}_filtered.txt",
               sample=config["samples_id"]),
        expand("results/{sample}/rgi_bwt_preprocessing/{sample}_selected.txt",
               sample=config["samples_id"]),
        "results/summary/rgi_bwt_all_samples.tsv",
        "results/summary/rgi_bwt_aggr_summary.txt",
        rules.r_analysis_bwt.input,
        rules.viz_bwt.input,


rule rgi_compare_all:
    """RGI main vs BWT comparison + comparative report."""
    input:
        rules.rgi_main_all.input,
        rules.rgi_bwt_all.input,
        "results/summary/rgi_comparison.tsv",
        "results/summary/rgi_comparison_report.html",


# ─── MGE ────────────────────────────────────────────────────────────────────────

rule mge_all:
    """Run complete MGE pipeline: detection → aggregation → R analysis → report."""
    input:
        expand(
            "results/{sample}/mge/{sample}_polished.fasta.summary.csv",
            sample=config["samples_id"]
        ),
        "results/summary/mge_all_samples.tsv",
        "results/summary/mge_per_sample.tsv",
        rules.mge_r_analysis.output,
        "results/figures/mge/mge_report.html",

# ─── Medaka ─────────────────────────────────────────────────────────────────────

rule medaka_all:
    """Medaka polishing of all raw Flye assemblies."""
    input:
        expand(
            "results/{sample}/medaka/{sample}_polished.fasta",
            sample=config["samples_id"]
        ),

# ─── Plasmid Finder ───────────────────────────────────────────────────────────

rule plasmidfinder_all:
    """Plasmid replicon typing on all polished assemblies."""
    input:
        expand("results/{sample}/plasmidfinder/{sample}_results_tab.tsv", sample=config["samples_id"])


# ─── Full pipeline ──────────────────────────────────────────────────────────────

rule all:
    """Full pipeline: taxonomy + Medaka + PlasmidFinder + RGI main + RGI BWT + MGE."""
    input:
        rules.taxonomy_all.input,
        rules.medaka_all.input,
        rules.plasmidfinder_all.input,
        rules.rgi_compare_all.input,
        rules.mge_all.input,
        rules.cooccurrence_all.input,

