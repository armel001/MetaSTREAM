# =============================================================================
# Resources — machine/study-specific content, populated after cloning
# =============================================================================
/results/*
/documentation/*
/resources/*
workflow/scripts/generate_arg_visualizations.py
workflow/scripts/plot_cooccurrence_report.py
workflow/scripts/plot_mge_report.py
workflow/scripts/plot_taxonomy_report.py
workflow/scripts/gene_review.py
workflow/scripts/compare_rgi_methods.py
workflow/scripts/cooccurrence_arg_mge.R

# --- Exceptions: keep directory structure (.gitkeep) and the bundled test set
!/resources/reads/
/resources/reads/*
!/resources/reads/.gitkeep

!/resources/references/
/resources/references/*
!/resources/references/.gitkeep

!/resources/db/
!/resources/db/kraken2_standard/
/resources/db/kraken2_standard/*
!/resources/db/kraken2_standard/.gitkeep

!/resources/db/card/
/resources/db/card/*
!/resources/db/card/.gitkeep

!/resources/db/mobileOG-db/
/resources/db/mobileOG-db/*
!/resources/db/mobileOG-db/.gitkeep

!/resources/db/plasmidfinder_db/
/resources/db/plasmidfinder_db/*
!/resources/db/plasmidfinder_db/.gitkeep

!/resources/tools/
!/resources/tools/mobileOG-pl/
/resources/tools/mobileOG-pl/*
!/resources/tools/mobileOG-pl/.gitkeep

!/resources/data_test/
!/resources/data_test/**

# --- RGI / CARD — deposited at repo root by `rgi load --local` (not redirected)
card*
wildcard/*
wildcard_annotation.log
wildcard_data.tar.bz2
wildcard_database_v4.0.1.fasta
wildcard_database_v4.0.1_all.fasta
localDB/*

# --- Legacy / to confirm still relevant
data
old_p1_results

dag.png
/benchmarks/*

# =============================================================================
# Local, machine-specific configuration — NEVER commit
# =============================================================================
config/config.local.yaml

# =============================================================================
# Snakemake cache and metadata
# =============================================================================
.snakemake/
!/.snakemake/logs/   # optional: keep run logs under version control if desired
!/.snakemake/config/ # optional: keep resolved config snapshots if desired

.snakemake_timestamp
.snakemake_metadata.json

# =============================================================================
# Raw sequencing data — safety net beyond /resources/*
# =============================================================================
*.fastq.gz
!resources/data_test/*.fastq.gz
*.fastq

# =============================================================================
# OS / editor artifacts
# =============================================================================
.DS_Store
*.swp
*.save

# =============================================================================
# Generic logs / temp / cache
# =============================================================================
logs/
tmp/
.cache/
*.log
*.tmp
*.bak
resources/db/kraken2_standard
